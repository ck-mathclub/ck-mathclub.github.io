---
import "../styles/global.css";
import {ClientRouter} from "astro:transitions";
---

<html lang="en">
<head>
    <meta charset="UTF-8"/>
    <meta name="viewport" content="width=device-width"/>
    <title>Math Club</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg"/>
    <meta name="generator" content={Astro.generator}/>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="../styles/global.css"/>
    <ClientRouter/>
</head>
<body>
<header transition:animate="initial">
    <nav id="main-nav" class=" text-blue-900 border-b-1 border-accent-250 navigation-container">
        <div class="nav-row main-row h-12 flex items-center justify-center">
            <ul class="nav-menu">
                <li class="nav-item">
                    <a href="/" class="nav-link">Home</a>
                </li>
                <li class="nav-item dropdown" data-submenu="about">
                    <span class="nav-link dropdown-trigger">About
                        <svg class="dropdown-arrow" width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="2,4 6,8 10,4"/>
                        </svg>
                    </span>
                    <ul class="dropdown-menu">
                        <li><a href="/about/accomplishments" class="dropdown-link">Accomplishments</a></li>
                        <li><a href="/about/schedule" class="dropdown-link">Schedule</a></li>
                    </ul>
                </li>
                <li class="nav-item dropdown" data-submenu="events">
                    <span class="nav-link dropdown-trigger">Events
                        <svg class="dropdown-arrow" width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="2,4 6,8 10,4"/>
                        </svg>
                    </span>
                    <ul class="dropdown-menu">
                        <li><a href="/events/estimathon" class="dropdown-link">CK Estimathon</a></li>
                        <li><a href="/events/int-bee" class="dropdown-link">Integration Bee</a></li>
                        <li><a href="/events/competition-signup" class="dropdown-link">Competition Signup</a></li>
                    </ul>
                </li>
                <li class="nav-item dropdown" data-submenu="journal">
                    <span class="nav-link dropdown-trigger">Journal
                        <svg class="dropdown-arrow" width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="2,4 6,8 10,4"/>
                        </svg>
                    </span>
                    <ul class="dropdown-menu">
                        <li><a href="/journal/contribute" class="dropdown-link">Contribute</a></li>
                        <li><a href="/journal/archive" class="dropdown-link">Archive</a></li>
                    </ul>
                </li>
            </ul>
        </div>
    </nav>
</header>
<main class="w-full pt-[40px]">
    <slot/>
</main>
<footer transition:animate="initial">
    <p>&copy; 2025 Math Club</p>
    <p>
        Visitors:
        <img class="inline" src="https://hits.sh/ck-mathclub/ck-mathclub.github.io.svg?style=flat-square&label=visits"
             alt="Visitor counter">
    </p>
</footer>
</body>
</html>



<style is:global>
    /* Style for the fixed navigation */
    header {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        z-index: 50;
        //box-shadow: 0 2px 32px rgba(255, 255, 255, 1);
    }
</style>

<script>
    // Simple initialization for any additional dropdown functionality
    document.addEventListener('DOMContentLoaded', function() {
        // The dropdowns now work primarily with CSS :hover pseudo-classes
        // This script is mainly here for any future enhancements
        console.log('Navigation initialized');
    });

    // Re-initialize on page transitions (Astro's client-side routing)
    document.addEventListener('astro:page-load', function() {
        console.log('Navigation re-initialized after page transition');
    });
</script>
