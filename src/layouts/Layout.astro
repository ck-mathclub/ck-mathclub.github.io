---
import "../styles/global.css";
import {ClientRouter} from "astro:transitions";
---

<html lang="en">
<head>
    <meta charset="UTF-8"/>
    <meta name="viewport" content="width=device-width"/>
    <title>Math Club</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg"/>
    <meta name="generator" content={Astro.generator}/>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="../styles/global.css"/>
    <ClientRouter/>
</head>
<body>
<header transition:animate="initial">
    <nav id="main-nav" class="bg-accent-200 text-blue-900 h-12 flex items-center justify-center border-b-1 border-accent-250">
        <ul >
            <li><a href="/" >About</a></li>
            <li><a href="/accomplishments">Accomplishments</a></li>
            <li><a href="/estimathon">CK Estimathon</a></li>
            <li><a href="/IntBee/int-bee">CK Integration Bee</a></li>
        </ul>
    </nav>

</header>
<main class="w-full pt-[40px]">
    <slot/>
</main>
<footer transition:animate="initial">
    <p>&copy; 2025 Math Club</p>
    <p>
        Visitors:
        <img class="inline" src="https://hits.sh/ck-mathclub/ck-mathclub.github.io.svg?style=flat-square&label=visits"
             alt="Visitor counter">
    </p>
</footer>
</body>
</html>



<style is:global>
    /* Style for the fixed navigation */
    header {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        z-index: 50;
        //box-shadow: 0 2px 32px rgba(255, 255, 255, 1);
    }

</style>
