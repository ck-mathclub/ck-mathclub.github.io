---
import Layout from "../layouts/Layout.astro";
import Deco_polyhedra from "../components/deco_polyhedra.astro";
import Thumbnail from "../components/thumbnail.astro";
import Carousel from "../components/carousel.astro";

// Create array of thumbnail data (you can expand this easily)
const thumbnailItems = [
    { id: 1 },
    { id: 2 },
    { id: 3 }
];
---
<Layout>
    <div class="w-full bg-accent-200 flex flex-col items-center">
        <div class="border-1 pt-40 flex flex-col gap-20 max-w-[1440px] w-full">
            <div class="flex flex-col gap-4 mx-20">
                <div class="text-5xl text-accent-800 font-bold">
                    Welcome to<br>Cranbrook Math Club!
                </div>

                <button class="bg-accent-200 border-1 border-accent-800 text-accent-800 py-2 mb-2 px-4 rounded-[16px] w-fit" type="button">
                    Join our mailing list ->
                </button>
                <Deco_polyhedra></Deco_polyhedra>
            </div>

            <div class="mx-0">
                <Carousel items={thumbnailItems}>
                    <Thumbnail />
                </Carousel>
            </div>
        </div>
        <div class="flex border-1">

        </div>
    </div>
</Layout>
