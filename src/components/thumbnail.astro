---

---

<div class="thumbnail-component">
    <div class="thumbnail-content">
        <div class="poster-container">
            <div class="poster bg-yellow-300 shadow-lg">
                poster
            </div>
        </div>
        <div class="text-content">
            <span>Check out our last club journal
                <svg class="arrow-icon" width="20" height="16" viewBox="-2 0 20 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line class="arrow-stem" x1="0" y1="8" x2="16" y2="8"/>
                    <polyline class="arrow-head" points="0,4 4,8 0,12"/>
                </svg>
            </span>
        </div>
    </div>
</div>

<style>
    .thumbnail-component {
        container-type: inline-size;

        width: 100%;
    }

    .thumbnail-content {
        padding: 0 0rem;
        width: 100%;

        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: left;
        gap: 0.75rem;
    }

    .poster-container {
        border: 1px solid var(--color-accent-800);
        border-radius: 0.5rem;
        width: 100%;
        max-height: 396px;
        max-width: 306px;
        aspect-ratio: 17 / 22; /* US letter ratio */
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .poster {
        border-radius: 0.5rem;
        width: 100%;
        height: 100%;
        aspect-ratio: 17 / 22; /* Ensures consistent ratio */
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .text-content {
        margin-right: 1rem;
        width: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        text-align: left;
        gap: 0.5rem;
    }

    .arrow-icon {
        display: inline;
        vertical-align: middle;
        margin-left: 4px;
        flex-shrink: 0;
        overflow: hidden;
    }

    .arrow-stem {
        clip-path: inset(0 100% 0 0);
        transition: clip-path 0.3s ease;
    }

    .arrow-head {
        transition: transform 0.3s ease;
    }

    .thumbnail-component:hover .arrow-stem {
        clip-path: inset(0 0 0 0);
    }

    .thumbnail-component:hover .arrow-head {
        transform: translateX(12px);
    }

    @container (min-width: 360px) {
        .thumbnail-content {
            padding: 0;
            flex-direction: row;
            align-items: end;
        }

        .poster-container {
            width: 60%;
        }

        .text-content {
            padding: 0 0;
            flex: 1;
            width: 50%;
            text-align: left;
            justify-content: flex-start;
        }
    }

</style>
